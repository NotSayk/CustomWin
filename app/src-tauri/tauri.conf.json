{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CustomWin",
  "version": "0.2.0",
  "identifier": "io.github.notsayk.customwin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare-sidecars && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CustomWin",
        "width": 1180,
        "height": 780,
        "minWidth": 880,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Optimise et personnalise Windows, en un clic et réversible",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/customwin-helper", "binaries/customwin-desktop"],
    "resources": { "binaries/customwin_taskbar.dll": "customwin_taskbar.dll" },
    "windows": {
      "nsis": {
        "languages": ["French", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
